# Copy to .env and fill in real values for the test server. Never commit .env.

# Host/IP the test server is reachable on (used for Keycloak's public issuer URL and for
# allowing the deployed frontend's origin through backend CORS)
SERVER_HOST=192.168.0.242

# Postgres
DB_NAME=couponGenerator
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Keycloak
KEYCLOAK_REALM=petrotrade
KEYCLOAK_ADMIN_CLIENT_ID=coupon-admin-api
KEYCLOAK_ADMIN_CLIENT_SECRET=local-dev-admin-api-secret

# QR signing
QR_SECRET_KEY=change-me-in-production-qr-secret

# ERP integration
ERP_ENABLED=true
ERP_MOCK=true
ERP_SALES_ENABLED=false
ERP_SALES_MOCK=true
